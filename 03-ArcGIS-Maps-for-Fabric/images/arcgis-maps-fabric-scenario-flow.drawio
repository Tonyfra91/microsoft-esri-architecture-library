<mxfile host="app.diagrams.net">
  <diagram id="arcgis-maps-scenario-flow" name="Scenario flow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="ArcGIS Maps for Microsoft Fabric - Map Authoring Scenario Flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F1F1F;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1100" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Documented user and data-selection workflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="54" width="800" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="1180" y="12" width="400" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="lg-t" value="Legend (ownership)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="14" width="150" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="lg-ms" value="Microsoft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#0B4F9C;strokeWidth=2;fontSize=12;fontColor=#0B2A4F;" vertex="1" parent="1">
          <mxGeometry x="1190" y="38" width="110" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="lg-esri" value="Esri" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF3E4;strokeColor=#16692F;strokeWidth=2;fontSize=12;fontColor=#0B3A19;" vertex="1" parent="1">
          <mxGeometry x="1310" y="38" width="110" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="lg-cu" value="Customer-owned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D1;strokeColor=#8A4B00;strokeWidth=2;dashed=1;fontSize=12;fontColor=#4D2900;" vertex="1" parent="1">
          <mxGeometry x="1430" y="38" width="140" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="Enable and authorize" style="swimlane;startSize=34;align=left;spacingLeft=12;fillColor=#F3F8FD;strokeColor=#0B4F9C;fontSize=17;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="500" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="Prepare and author" style="swimlane;startSize=34;align=left;spacingLeft=12;fillColor=#F7F7F7;strokeColor=#555555;fontSize=17;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="110" width="700" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="Save and validate" style="swimlane;startSize=34;align=left;spacingLeft=12;fillColor=#FFF9EE;strokeColor=#8A4B00;fontSize=17;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="110" width="320" height="540" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1. Admin enables workload&lt;/b&gt;&lt;br&gt;Fabric tenant administrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#0B4F9C;strokeWidth=2;fontSize=15;fontColor=#0B2A4F;" vertex="1" parent="1">
          <mxGeometry x="70" y="190" width="400" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Microsoft sign-in and workspace access&lt;/b&gt;&lt;br&gt;Map author in browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#0B4F9C;strokeWidth=2;fontSize=15;fontColor=#0B2A4F;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="400" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Create ArcGIS Maps for Fabric item&lt;/b&gt;&lt;br&gt;In a Fabric workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF3E4;strokeColor=#16692F;strokeWidth=3;fontSize=15;fontColor=#0B3A19;" vertex="1" parent="1">
          <mxGeometry x="580" y="190" width="290" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. ArcGIS organizational sign-in&lt;/b&gt;&lt;br&gt;From the item; ArcGIS Online account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF3E4;strokeColor=#16692F;strokeWidth=2;fontSize=15;fontColor=#0B3A19;" vertex="1" parent="1">
          <mxGeometry x="930" y="190" width="290" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Add Lakehouse data&lt;/b&gt;&lt;br&gt;OneLake catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D1;strokeColor=#8A4B00;strokeWidth=2;dashed=1;fontSize=15;fontColor=#4D2900;" vertex="1" parent="1">
          <mxGeometry x="570" y="400" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Add ArcGIS Online content&lt;/b&gt;&lt;br&gt;Available to signed-in user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF3E4;strokeColor=#16692F;strokeWidth=2;fontSize=15;fontColor=#0B3A19;" vertex="1" parent="1">
          <mxGeometry x="810" y="400" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Add Living Atlas content&lt;/b&gt;&lt;br&gt;Curated layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF3E4;strokeColor=#16692F;strokeWidth=2;fontSize=15;fontColor=#0B3A19;" vertex="1" parent="1">
          <mxGeometry x="1050" y="400" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;8. Save / open map&lt;/b&gt;&lt;br&gt;Saved map artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D1;strokeColor=#8A4B00;strokeWidth=2;dashed=1;fontSize=15;fontColor=#4D2900;" vertex="1" parent="1">
          <mxGeometry x="1290" y="400" width="260" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#1F1F1F;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#1F1F1F;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="450"/><mxPoint x="530" y="240"/></Array></mxGeometry></mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#1F1F1F;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#1F1F1F;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1075" y="345"/><mxPoint x="670" y="345"/></Array></mxGeometry></mxCell>
        <mxCell id="e46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#1F1F1F;strokeWidth=2;" edge="1" parent="1" source="s4" target="s6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1075" y="345"/><mxPoint x="910" y="345"/></Array></mxGeometry></mxCell>
        <mxCell id="e47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#1F1F1F;strokeWidth=2;" edge="1" parent="1" source="s4" target="s7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1075" y="345"/><mxPoint x="1135" y="345"/></Array></mxGeometry></mxCell>
        <mxCell id="branchlbl" value="Choose one or more documented source paths" style="text;html=1;align=left;verticalAlign=bottom;fontSize=13;fontStyle=2;fontColor=#1F1F1F;" vertex="1" parent="1">
          <mxGeometry x="640" y="312" width="400" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#1F1F1F;strokeWidth=2;" edge="1" parent="1" source="s5" target="s8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="570"/><mxPoint x="1420" y="570"/></Array></mxGeometry></mxCell>
        <mxCell id="e68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#1F1F1F;strokeWidth=2;" edge="1" parent="1" source="s6" target="s8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="570"/><mxPoint x="1420" y="570"/></Array></mxGeometry></mxCell>
        <mxCell id="e78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#1F1F1F;strokeWidth=2;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="570"/><mxPoint x="1420" y="570"/></Array></mxGeometry></mxCell>

        <mxCell id="val" value="&lt;b&gt;VALIDATION REQUIRED&lt;/b&gt;&lt;br&gt;Sharing and publishing beyond save/open" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#B00020;strokeWidth=3;dashed=1;dashPattern=8 4;fontSize=16;fontColor=#1F1F1F;" vertex="1" parent="1">
          <mxGeometry x="1000" y="690" width="580" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="footer" value="Not a deployment or network architecture. Numbers show the documented sequence; no hosting, data-movement or service-to-service paths are implied." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="840" width="1560" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
